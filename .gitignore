# Dependencies
node_modules/
.pnp
.pnp.js
.pnp.cjs
.pnp.loader.mjs

# Testing
coverage/

# Production
# We include dist/ because this repo is the distribution point
# dist/

# Misc
.DS_Store
*.log
.gemini/tmp/
.gemini/logs/

# Local configuration files (dotenv)
# Every .env variant holds machine- or environment-specific values, so none are
# committed. Share required keys through .env.example instead. .envrc is tracked
# on purpose and is not matched here: it only loads these files.
.env
.env.*
!.env.example

# npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.eslintcache
*.tsbuildinfo

# Yarn Berry: keep project-level plugins, patches and releases, drop the rest
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
