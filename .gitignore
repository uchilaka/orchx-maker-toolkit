# Dependencies
# mise pins node for the skill validator; there is no package.json, but ignore
# node_modules/ in case a script pulls packages in locally.
node_modules/

# Testing
coverage/

# Production
# We include dist/ because this repo is the distribution point
# dist/

# Misc
.DS_Store
*.log
.gemini/tmp/
.gemini/logs/

# Local configuration files (dotenv)
# Every .env variant holds machine- or environment-specific values, so none are
# committed. Share required keys through .env.example instead. .envrc is tracked
# on purpose and is not matched here: it only loads these files.
.env
.env.*
!.env.example
