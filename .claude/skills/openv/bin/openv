#!/usr/bin/env bash
# openv — load Proton Pass secrets into a command's environment on demand,
# from templates of pass:// references kept in ~/.config/openv/.
#
# This is the one script the openv skill and its harness adapters depend on. It
# is also linked onto PATH (~/.local/bin/openv) so it works in any terminal.
# It reads nothing harness-specific except the agent env vars `export` refuses
# under (S5). Bash 3.2 compatible (macOS /bin/bash): no associative arrays, no
# mapfile.
#
# Config layout (all optional):
#   ~/.config/openv/vaults               global vault allowlist, one name per line
#   ~/.config/openv/global/<env>.env     profiles usable from any directory
#   ~/.config/openv/<project>/<env>.env  profiles for one git project
#   ~/.config/openv/<project>/vaults     replaces the global allowlist there
# <project> is the main checkout's directory name, so every worktree of a repo
# shares one set of profiles. A project profile wins over a global one of the
# same name.
set -euo pipefail

OPENV_VERSION="0.4.0" # 0.1.0 skeleton; 0.2.0 status (S3); 0.3.0 run + export (S5); 0.4.0 items (S4)
CONFIG_DIR="${OPENV_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/openv}"
LINK_PATH="${OPENV_LINK_PATH:-$HOME/.local/bin/openv}"

usage() {
  cat <<'USAGE'
Usage: openv <command> [args]

Commands:
  status [--check] [--json]       Profiles, vault allowlist, deps (--check: login)
  run <env> -- <cmd>...           Run a command with the profile's secrets, masked
  export <env>                    Print export lines for eval (terminal only, not agents)
  items [--vault V]               Item titles and types in the allowed vaults
  items --fields <vault>/<title>  One item's field names and types, never values
  version                         Print the version
USAGE
}

die() {
  echo "openv: $*" >&2
  exit 1
}

# --- project and config paths -------------------------------------------------

# The main checkout's directory name, or empty outside a git repo. One git call.
# --git-common-dir is <main>/.git from the main checkout and every worktree, so
# worktrees resolve to the same project. A bare-repo layout falls back to the
# common dir's own name.
project_name() {
  local common
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
  case "$common" in
    */.git) basename "$(dirname "$common")" ;;
    *) basename "$common" .git ;;
  esac
}

# The allowlist in force: the project's file replaces the global one when it
# exists, so a project can narrow (or widen) access without editing the global.
vaults_file() {
  local project="$1"
  if [ -n "$project" ] && [ -f "$CONFIG_DIR/$project/vaults" ]; then
    echo "$CONFIG_DIR/$project/vaults"
  elif [ -f "$CONFIG_DIR/vaults" ]; then
    echo "$CONFIG_DIR/vaults"
  fi
}

# Non-blank, non-comment lines, trimmed.
read_list() {
  [ -n "$1" ] && [ -f "$1" ] || return 0
  sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$1" | grep -v '^$' || true
}

# Prints "<env>\t<scope>\t<path>" per profile. Project profiles first, then
# global ones whose env name the project doesn't already define.
list_profiles() {
  local project="$1" f env seen=" "
  if [ -n "$project" ] && [ -d "$CONFIG_DIR/$project" ]; then
    for f in "$CONFIG_DIR/$project"/*.env; do
      [ -f "$f" ] || continue
      env="$(basename "$f" .env)"
      seen="$seen$env "
      printf '%s\tproject\t%s\n' "$env" "$f"
    done
  fi
  if [ -d "$CONFIG_DIR/global" ]; then
    for f in "$CONFIG_DIR/global"/*.env; do
      [ -f "$f" ] || continue
      env="$(basename "$f" .env)"
      case "$seen" in *" $env "*) continue ;; esac
      printf '%s\tglobal\t%s\n' "$env" "$f"
    done
  fi
}

# Prints "<var>\t<kind>\t<ref>" per assignment in a dotenv profile. <kind> is
# `ref` for a pass:// reference (printed: a reference names where a secret
# lives, not what it is) or `literal` (value never printed: a literal can be a
# secret pasted in by mistake).
#
# A line written `export KEY=...` is reported as `ignored`: pass-cli's dotenv
# parser skips it, so the variable never resolves (and `export` must not print
# KEY='' over the user's existing value).
profile_vars() {
  local line key value ignored
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in '' | '#'*) continue ;; esac
    ignored=""
    case "$line" in 'export '*) line="${line#export }"; ignored=1 ;; esac
    case "$line" in *=*) ;; *) continue ;; esac
    key="${line%%=*}"
    if [ -n "$ignored" ]; then printf '%s\tignored\t\n' "$key"; continue; fi
    value="${line#*=}"
    value="${value%\"}"; value="${value#\"}"
    value="${value%\'}"; value="${value#\'}"
    case "$value" in
      pass://*) printf '%s\tref\t%s\n' "$key" "$value" ;;
      *) printf '%s\tliteral\t\n' "$key" ;;
    esac
  done <"$1"
}

# Names `export` refuses. Each one changes how a shell or the dynamic loader
# starts, so a profile that sets one could run code in the user's terminal, which
# matters once anything but the user can write ~/.config/openv (security review on
# PR #34, findings 2 and 3).
unsafe_name() {
  case "$1" in
    PATH | IFS | ENV | BASH_ENV | SHELLOPTS | BASHOPTS | PS[0-9] | PROMPT_COMMAND | \
      ZDOTDIR | CDPATH | LD_* | DYLD_* | BASH_FUNC_*) return 0 ;;
  esac
  return 1
}

# The warning `status` shows for a profile variable, or nothing.
var_warning() {
  if [ "$2" = ignored ]; then
    echo 'pass-cli skips lines that start with "export "'
  elif unsafe_name "$1"; then
    echo 'export refuses this name'
  fi
}

# Resolves <env> to a profile file: project first, then global. Rejects path
# traversal so <env> stays inside $CONFIG_DIR.
resolve_profile() {
  local env="$1" project p
  case "$env" in
    '' | */* | *..*) die "invalid profile name: $env" ;;
  esac
  project="$(project_name)"
  if [ -n "$project" ]; then
    p="$CONFIG_DIR/$project/$env.env"
    if [ -f "$p" ]; then echo "$p"; return 0; fi
  fi
  p="$CONFIG_DIR/global/$env.env"
  if [ -f "$p" ]; then echo "$p"; return 0; fi
  if [ -n "$project" ]; then
    die "profile \"$env\" not found (looked in $CONFIG_DIR/$project/$env.env and $CONFIG_DIR/global/$env.env; run 'openv status')"
  else
    die "profile \"$env\" not found (looked in $CONFIG_DIR/global/$env.env; run 'openv status')"
  fi
}

# --- status ---------------------------------------------------------------------

json_str() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  s="${s//$'\t'/\\t}"; s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"
  printf '"%s"' "$s"
}

dep_path() { command -v "$1" 2>/dev/null || true; }

# Follows a symlink chain to a physical path. macOS 3.2-era userland has no
# `readlink -f`, hence the loop. Prints nothing for a dangling link.
resolve() {
  local p="$1" t
  while [ -L "$p" ]; do
    t="$(readlink "$p")"
    case "$t" in /*) p="$t" ;; *) p="$(dirname "$p")/$t" ;; esac
  done
  [ -e "$p" ] || return 0
  echo "$(cd "$(dirname "$p")" && pwd -P)/$(basename "$p")"
}

# "linked" when LINK_PATH resolves to this script, "foreign" when it's some
# other file, "dangling" for a broken link, "missing" when absent.
link_state() {
  local self target
  self="$(resolve "${BASH_SOURCE[0]}")"
  if [ ! -L "$LINK_PATH" ] && [ ! -e "$LINK_PATH" ]; then echo missing; return; fi
  target="$(resolve "$LINK_PATH")"
  if [ -z "$target" ]; then echo dangling
  elif [ "$target" = "$self" ]; then echo linked
  else echo foreign
  fi
}

on_path() {
  case ":$PATH:" in *":$(dirname "$LINK_PATH"):"*) echo yes ;; *) echo no ;; esac
}

# The one network call in status, and only under --check: the exit code of a
# metadata listing. Its output is discarded, so nothing it prints can leak.
login_state() {
  [ -n "$(dep_path pass-cli)" ] || { echo unavailable; return; }
  if pass-cli vault list >/dev/null 2>&1; then echo yes; else echo no; fi
}

cmd_status() {
  local check=0 json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check=1 ;;
      --json) json=1 ;;
      *) die "status: unknown option $1" ;;
    esac
    shift
  done

  local project vfile profiles login="" link
  project="$(project_name)"
  vfile="$(vaults_file "$project")"
  profiles="$(list_profiles "$project")"
  link="$(link_state)"
  [ "$check" -eq 1 ] && login="$(login_state)"

  if [ "$json" -eq 1 ]; then
    status_json "$project" "$vfile" "$profiles" "$login" "$link"
  else
    status_text "$project" "$vfile" "$profiles" "$login" "$link"
  fi
}

status_text() {
  local project="$1" vfile="$2" profiles="$3" login="$4" link="$5" env scope path var kind ref warning line
  echo "config:   $CONFIG_DIR"
  echo "project:  ${project:-(none: not in a git repo, global profiles only)}"
  if [ "$project" = global ]; then
    echo "warning:  a project named \"global\" shares ~/.config/openv/global with the global scope"
  fi
  if [ -n "$vfile" ]; then
    echo "vaults:   $(read_list "$vfile" | paste -sd, - | sed 's/,/, /g')  ($vfile)"
  else
    echo "vaults:   (none: create $CONFIG_DIR/vaults, one vault name per line)"
  fi
  if [ -z "$profiles" ]; then
    echo "profiles: (none)"
  else
    echo "profiles:"
    while IFS=$'\t' read -r env scope path; do
      echo "  $env  [$scope]  $path"
      while IFS=$'\t' read -r var kind ref; do
        warning="$(var_warning "$var" "$kind")"
        case "$kind" in
          ref) line="    $var -> $ref" ;;
          ignored) line="    $var  ! ignored: $warning"; warning="" ;;
          *) line="    $var = (literal)" ;;
        esac
        echo "$line${warning:+  ! $warning}"
      done < <(profile_vars "$path")
    done <<<"$profiles"
  fi
  local pass jq
  pass="$(dep_path pass-cli)"; jq="$(dep_path jq)"
  echo "deps:     pass-cli ${pass:-(missing: brew install protonpass/tap/pass-cli)}"
  echo "          jq ${jq:-(missing: brew install jq; only \`items\` needs it)}"
  echo "link:     $LINK_PATH: $link$([ "$link" = linked ] && [ "$(on_path)" = no ] && echo " (but $(dirname "$LINK_PATH") is not on PATH)")"
  [ -z "$login" ] || echo "login:    $login"
}

status_json() {
  local project="$1" vfile="$2" profiles="$3" login="$4" link="$5" env scope path var kind ref first sep warning
  printf '{"config":%s,"project":%s,' "$(json_str "$CONFIG_DIR")" "$( [ -n "$project" ] && json_str "$project" || echo null)"
  printf '"vaults":{"file":%s,"names":[' "$( [ -n "$vfile" ] && json_str "$vfile" || echo null)"
  sep=""
  while IFS= read -r var; do
    [ -n "$var" ] || continue
    printf '%s%s' "$sep" "$(json_str "$var")"; sep=","
  done < <(read_list "$vfile")
  printf ']},"profiles":['
  first=1
  if [ -n "$profiles" ]; then
    while IFS=$'\t' read -r env scope path; do
      [ "$first" -eq 1 ] || printf ','
      first=0
      printf '{"env":%s,"scope":%s,"path":%s,"vars":[' "$(json_str "$env")" "$(json_str "$scope")" "$(json_str "$path")"
      sep=""
      while IFS=$'\t' read -r var kind ref; do
        warning="$(var_warning "$var" "$kind")"
        printf '%s{"name":%s,"kind":%s,"ref":%s,"warning":%s}' "$sep" "$(json_str "$var")" "$(json_str "$kind")" \
          "$( [ "$kind" = ref ] && json_str "$ref" || echo null)" "$( [ -n "$warning" ] && json_str "$warning" || echo null)"
        sep=","
      done < <(profile_vars "$path")
      printf ']}'
    done <<<"$profiles"
  fi
  printf '],"deps":{"pass-cli":%s,"jq":%s},' \
    "$( [ -n "$(dep_path pass-cli)" ] && json_str "$(dep_path pass-cli)" || echo null)" \
    "$( [ -n "$(dep_path jq)" ] && json_str "$(dep_path jq)" || echo null)"
  printf '"link":{"path":%s,"state":%s,"on_path":%s}' "$(json_str "$LINK_PATH")" "$(json_str "$link")" "$( [ "$(on_path)" = yes ] && echo true || echo false)"
  [ -z "$login" ] || printf ',"login":%s' "$(json_str "$login")"
  printf '}\n'
}

# --- run and export -----------------------------------------------------------

require_pass_cli() {
  [ -n "$(dep_path pass-cli)" ] || die "pass-cli not found (brew install protonpass/tap/pass-cli)"
}

cmd_run() {
  if [ $# -lt 1 ]; then
    echo "Usage: openv run <env> -- <cmd>..." >&2
    exit 64
  fi
  local env="$1"
  shift
  if [ "${1:-}" != "--" ] || [ $# -lt 2 ]; then
    echo "Usage: openv run <env> -- <cmd>..." >&2
    exit 64
  fi
  shift
  local profile
  profile="$(resolve_profile "$env")"
  require_pass_cli
  exec pass-cli run --env-file "$profile" -- "$@"
}

# Refuses under a known agent env var, or without a TTY on stdin (agent Bash
# tools don't attach one; `eval "$(openv export dev)"` in a terminal keeps it).
# These checks are ADVISORY: they stop accidents, not a determined agent, which
# can unset the env vars and wrap the call in a pseudo-terminal (`script`,
# `pty.spawn`). The real boundary is the agent having no pass-cli login.
cmd_export() {
  if [ -n "${CLAUDECODE:-}" ] || [ -n "${OPENCODE_SESSION_ID:-}" ]; then
    die "export is disabled inside agent sessions; use 'openv run <env> -- <cmd>' instead"
  fi
  if [ ! -t 0 ]; then
    die "export requires an interactive terminal on stdin; use 'openv run <env> -- <cmd>' instead"
  fi
  if [ $# -ne 1 ]; then
    echo "Usage: openv export <env>" >&2
    exit 64
  fi
  local env="$1" profile var kind _ wanted=" "
  profile="$(resolve_profile "$env")"
  while IFS=$'\t' read -r var kind _; do
    [ "$kind" != ignored ] || continue
    if unsafe_name "$var"; then
      die "refusing to export $var: it changes how a shell or the loader starts ($profile)"
    fi
    case "$var" in
      '' | [0-9]* | *[!A-Za-z0-9_]*) continue ;;
    esac
    wanted="$wanted$var "
  done < <(profile_vars "$profile")
  [ "$wanted" != " " ] || return 0
  require_pass_cli
  # pass-cli's own dotenv + pass:// parser resolves the profile (no second
  # parser), and `env -0` prints the result. No shell starts with the profile's
  # variables in its environment, so none of them can hook shell startup, and
  # this function has no variables a profile name could shadow. The sentinel
  # proves pass-cli ran `env`, since a process substitution hides its exit code.
  local entry name value qt="'" rep ok="" out=""
  rep="${qt}\\${qt}${qt}"
  while IFS= read -r -d '' entry; do
    name="${entry%%=*}"
    if [ "$name" = __OPENV_RESOLVED ]; then ok=1; continue; fi
    case "$wanted" in *" $name "*) ;; *) continue ;; esac
    value="${entry#*=}"
    out="${out}export $name=$qt${value//$qt/$rep}$qt"$'\n'
  done < <(pass-cli run --no-masking --env-file "$profile" -- /usr/bin/env -0 __OPENV_RESOLVED=1)
  [ -n "$ok" ] || die "pass-cli could not resolve $profile (logged in? try 'openv status --check')"
  printf '%s' "$out"
}

# --- items --------------------------------------------------------------------

# What `items --fields` keeps from `item view --output json`, the one call here
# that returns values. An allowlist, not a denylist (plan S1): it emits a field's
# name and the type it's stored as, and reads a value only to skip an empty
# login field. Shapes, from S1: login fields under .item.content.content.Login,
# custom ones under .Custom.sections[].section_fields[] as {name, content:
# {<Type>: value}}, extra fields the same way, and the note on every item.
ITEM_FIELDS_JQ='
  def stored_as: if type == "object" then (keys[0] // "unknown") else "unknown" end;
  .item.content as $c
  | ( if (($c.note // "") | length) > 0 then ["note", "note"] else empty end ),
    ( ($c.content // {}) | to_entries[]
      | .key as $kind | .value
      | if $kind == "Login" then
          to_entries[]
          | select(.key | IN("username", "email", "password", "totp_uri", "urls"))
          | select((.value // "") | length > 0)
          | [.key, "login"]
        elif type == "object" then
          (.sections // [])[] | (.section_fields // [])[] | [.name, (.content | stored_as)]
        else empty end ),
    ( ($c.extra_fields // [])[] | [.name, (.content | stored_as)] )
  | select((.[0] | type) == "string")
  | @tsv
'

require_jq() {
  [ -n "$(dep_path jq)" ] || die "jq not found (brew install jq)"
}

is_allowed() { grep -Fxq -- "$1" <<<"$2"; }

# Titles and types from `item list`, which carries no values (S1), per allowed
# vault, or for one with --vault. --fields <vault>/<title> lists one item's
# field names and types. pass-cli's and jq's stderr are dropped on both paths:
# an error message can quote its input, and on --fields the input is values.
cmd_items() {
  local vault="" fields=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --vault | --fields)
        [ $# -ge 2 ] || die "items: $1 needs a value"
        if [ "$1" = --vault ]; then vault="$2"; else fields="$2"; fi
        shift ;;
      *) die "items: unknown option $1" ;;
    esac
    shift
  done
  [ -z "$vault" ] || [ -z "$fields" ] || die "items: use --vault or --fields, not both"

  local project vfile allowed
  project="$(project_name)"
  vfile="$(vaults_file "$project")"
  allowed="$(read_list "$vfile")"
  [ -n "$allowed" ] || die "no vaults allowed: list vault names in ${vfile:-$CONFIG_DIR/vaults}, one per line"

  if [ -n "$fields" ]; then
    local fvault="${fields%%/*}" title="${fields#*/}"
    case "$fields" in */*) ;; *) die "items: --fields takes <vault>/<title>" ;; esac
    [ -n "$fvault" ] && [ -n "$title" ] || die "items: --fields takes <vault>/<title>"
    is_allowed "$fvault" "$allowed" || die "vault \"$fvault\" isn't in the vault allowlist (${vfile})"
    require_pass_cli; require_jq
    pass-cli item view --vault-name "$fvault" --item-title "$title" --output json 2>/dev/null \
      | jq -r "$ITEM_FIELDS_JQ" 2>/dev/null \
      || die "couldn't read the fields of \"$title\" in \"$fvault\" (logged in? try 'openv status --check')"
    return 0
  fi

  if [ -n "$vault" ]; then
    is_allowed "$vault" "$allowed" || die "vault \"$vault\" isn't in the vault allowlist (${vfile})"
    allowed="$vault"
  fi
  require_pass_cli; require_jq
  local v
  while IFS= read -r v; do
    pass-cli item list "$v" --output json 2>/dev/null \
      | jq -r --arg v "$v" '.items[] | [$v, .item_type, .title] | @tsv' 2>/dev/null \
      || die "couldn't list vault \"$v\" (logged in? try 'openv status --check')"
  done <<<"$allowed"
}

main() {
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    status) cmd_status "$@" ;;
    run) cmd_run "$@" ;;
    export) cmd_export "$@" ;;
    items) cmd_items "$@" ;;
    version | --version | -V) echo "openv $OPENV_VERSION" ;;
    help | --help | -h) usage ;;
    *)
      echo "openv: unknown or not-yet-implemented command: $cmd" >&2
      usage >&2
      exit 64
      ;;
  esac
}

main "$@"
