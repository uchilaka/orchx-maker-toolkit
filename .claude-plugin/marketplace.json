{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "orchx-maker-toolkit",
  "description": "Claude Code skills and agents from the OrchX Maker Toolkit",
  "owner": { "name": "Uchenna Chilaka", "url": "https://github.com/uchilaka" },
  "plugins": [
    {
      "name": "orchx-maker",
      "source": "./",
      "description": "Claude-native skills from the OrchX Maker Toolkit",
      "skills": [
        "./.claude/skills/patch-my-hosts",
        "./.claude/skills/llm-wikify",
        "./.claude/skills/browser-test-assist",
        "./.claude/skills/browse"
      ]
    },
    {
      "name": "hot-reload-preview",
      "source": "./",
      "description": "Starts the /browse live-reload preview server when a session starts",
      "skills": [],
      "dependencies": ["orchx-maker"],
      "hooks": {
        "SessionStart": [
          {
            "matcher": "startup",
            "hooks": [
              { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/.claude/skills/browse/ensure-server.sh --open >/dev/null 2>&1" }
            ]
          }
        ]
      }
    }
  ]
}
